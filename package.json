{
  "name": "codemap",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "setup:local": "npm run prisma:generate && npm --workspace @codemap/api run prisma:deploy && npm run prisma:seed",
    "dev:web": "npm --workspace @codemap/web run dev",
    "dev:api": "npm --workspace @codemap/api run start:dev",
    "dev:worker": "npm --workspace @codemap/api run start:worker:dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "prisma:generate": "npm --workspace @codemap/api run prisma:generate",
    "prisma:migrate": "npm --workspace @codemap/api run prisma:migrate",
    "prisma:seed": "npm --workspace @codemap/api run prisma:seed",
    "prisma:reset": "npm --workspace @codemap/api run prisma:reset",
    "prisma:studio": "npm --workspace @codemap/api run prisma:studio"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22.x"
  }
}
